NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — never expose to the browser. Used to invite/manage team
# accounts from the admin pages. Find it in Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only — used to send shift assignment emails.
RESEND_API_KEY=your-resend-api-key
# Optional — defaults to onboarding@resend.dev (test sender). Set this once
# you've verified your own domain in Resend.
# RESEND_FROM_EMAIL=Plandex <planning@yourdomain.com>
