NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — used to send shift assignment emails.
RESEND_API_KEY=your-resend-api-key
# Optional — defaults to onboarding@resend.dev (test sender). Set this once
# you've verified your own domain in Resend.
# RESEND_FROM_EMAIL=Plandex <planning@yourdomain.com>

# Server-only — never expose to the browser. Used only by the daily
# reminder cron job (bypasses RLS to read every extra's shifts). Find it
# in Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only — protects /api/cron/reminders from being called by anyone
# else. Generate any random string; Vercel Cron sends it automatically
# as a Bearer token when this env var is set on the project.
CRON_SECRET=a-long-random-string
